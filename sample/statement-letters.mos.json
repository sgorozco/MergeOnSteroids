{
  "Name": "Customer statement letters",
  "OutputFolder": "output",
  "Blocks": [
    {
      "$type": "csvSource",
      "FilePath": "customers.csv",
      "Name": "customers",
      "Id": "f41c6fb2a7e2466aadba1ad9dca56e31"
    },
    {
      "$type": "csvSource",
      "FilePath": "orders.csv",
      "Name": "orders",
      "Id": "3fe1f81d4dc1402bb82ea522623ed87d"
    },
    {
      "$type": "forEach",
      "Alias": "c",
      "SourceName": "customers",
      "Children": [
        {
          "$type": "filterSource",
          "SourceName": "orders",
          "Condition": "CustomerId = c.Id",
          "Name": "custOrders",
          "Id": "9f722e28a09b4a55ac9223c0cca8db72"
        },
        {
          "$type": "newDocument",
          "FileNameTemplate": "Statement_{c.Company}",
          "TemplatePath": "",
          "Children": [
            {
              "$type": "paragraph",
              "TextTemplate": "ACME Distribution Inc.",
              "Style": "Title",
              "Bold": false,
              "Italic": false,
              "Id": "f4ef8e4cdf724b26b80d7fea625cd78d"
            },
            {
              "$type": "paragraph",
              "TextTemplate": "Account statement \u2014 {c.Company}",
              "Style": "Heading 1",
              "Bold": false,
              "Italic": false,
              "Id": "c1380913996e456c8b8cde49946a9e83"
            },
            {
              "$type": "paragraph",
              "TextTemplate": "Generated on {FORMAT(TODAY(), \u0022D\u0022)}",
              "Style": "Normal",
              "Bold": false,
              "Italic": false,
              "Id": "579a0c390cf94a339af0f8fb69fc5b23"
            },
            {
              "$type": "paragraph",
              "TextTemplate": "",
              "Style": "Normal",
              "Bold": false,
              "Italic": false,
              "Id": "432c252632e944cebc7abae0d30a6220"
            },
            {
              "$type": "paragraph",
              "TextTemplate": "Dear {c.Contact},",
              "Style": "Normal",
              "Bold": false,
              "Italic": false,
              "Id": "c0c253d080f9439a896deb07830b65c4"
            },
            {
              "$type": "if",
              "Condition": "COUNT(custOrders) \u003E 0",
              "Children": [
                {
                  "$type": "paragraph",
                  "TextTemplate": "Here is a summary of your {COUNT(custOrders)} order(s) this period:",
                  "Style": "Normal",
                  "Bold": false,
                  "Italic": false,
                  "Id": "4762e3ada51d47e5a205a7d9d116738f"
                },
                {
                  "$type": "table",
                  "SourceName": "custOrders",
                  "ColumnsSpec": "Date: FORMAT(Date, \u0022d\u0022) | Product: Product | Qty: Qty | Unit price: FORMAT(UnitPrice, \u0022C\u0022) | Total: FORMAT(Qty * UnitPrice, \u0022C\u0022)",
                  "HeaderRow": true,
                  "Id": "8cd3e5ed98c5437683c88de63a966f5c"
                },
                {
                  "$type": "paragraph",
                  "TextTemplate": "Grand total: {FORMAT(SUM(custOrders, Qty * UnitPrice), \u0022C\u0022)}",
                  "Style": "Normal",
                  "Bold": true,
                  "Italic": false,
                  "Id": "3f462f1ec6834a9a9bd9156987300ced"
                }
              ],
              "Else": [
                {
                  "$type": "paragraph",
                  "TextTemplate": "You have no orders this period \u2014 we would love to hear from you!",
                  "Style": "Normal",
                  "Bold": false,
                  "Italic": true,
                  "Id": "c31875e7330c46e6828dd9c573329b94"
                }
              ],
              "Id": "34be364dc23f4dc6a6ef7c4eab23b975"
            },
            {
              "$type": "if",
              "Condition": "SUM(custOrders, Qty * UnitPrice) \u003E 10000",
              "Children": [
                {
                  "$type": "paragraph",
                  "TextTemplate": "As one of our preferred customers, you qualify for a dedicated account manager. Expect a call from us soon.",
                  "Style": "Quote",
                  "Bold": false,
                  "Italic": false,
                  "Id": "70916730b94f4ea6bae2751239016613"
                }
              ],
              "Else": [],
              "Id": "0bac610dc92743e9abd46517f7e0d258"
            },
            {
              "$type": "paragraph",
              "TextTemplate": "",
              "Style": "Normal",
              "Bold": false,
              "Italic": false,
              "Id": "e79d49a675444214929bc7a9104048a3"
            },
            {
              "$type": "paragraph",
              "TextTemplate": "Kind regards,",
              "Style": "Normal",
              "Bold": false,
              "Italic": false,
              "Id": "b90e661de8b74da7859d0de2b0e7f2de"
            },
            {
              "$type": "paragraph",
              "TextTemplate": "The ACME team \u2014 {c.City} office",
              "Style": "Normal",
              "Bold": false,
              "Italic": true,
              "Id": "8acd99fd83f0444097955aaa6a5cf1f6"
            }
          ],
          "Id": "fffd0b16f05148759fcdfc095bad69c6"
        }
      ],
      "Id": "2bff56d05b0c448495a10ecd2273da30"
    }
  ]
}