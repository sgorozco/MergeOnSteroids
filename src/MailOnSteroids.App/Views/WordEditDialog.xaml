<Window x:Class="MailOnSteroids.App.Views.WordEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editing in Word"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Topmost="True">
    <StackPanel Margin="18">
        <TextBlock TextWrapping="Wrap" FontSize="13">
            The fragment is now open in <Bold>Microsoft Word</Bold>.
        </TextBlock>
        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#555">
            Write and format the paragraphs there — styles, colors, bullets, anything.
            Use {expressions} where data should be inserted, e.g. {c.Company}.
        </TextBlock>
        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#555">
            When you are done, come back here and click <Bold>Save &amp; return</Bold>.
            Do not close the Word document yourself.
        </TextBlock>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save &amp; return" Padding="14,6" Margin="0,0,8,0"
                    IsDefault="True" FontWeight="SemiBold" Click="Save_Click"/>
            <Button Content="Cancel" Padding="14,6" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
