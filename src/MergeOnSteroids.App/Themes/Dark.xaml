<!--
    Dark theme.  Mirrors every key in Light.xaml.  The canvas is the darkest
    surface so the (slightly deepened) block colors keep popping off it.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================== surfaces ============================== -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1B1E24"/>
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#22262E"/>
    <SolidColorBrush x:Key="ToolbarBorderBrush" Color="#32373F"/>
    <SolidColorBrush x:Key="PaletteBackgroundBrush" Color="#1E2229"/>
    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#14171C"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1E2229"/>
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#22262E"/>
    <SolidColorBrush x:Key="SplitterBrush" Color="#2B303A"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#3C434F"/>

    <!-- ============================== text ============================== -->
    <SolidColorBrush x:Key="ForegroundBrush" Color="#E4E7EC"/>
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#A7AEBA"/>
    <SolidColorBrush x:Key="SubtleForegroundBrush" Color="#858D9A"/>

    <!-- ============================== accent ============================== -->
    <Color x:Key="AccentColor">#5C9BFF</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#5C9BFF"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#10141A"/>

    <!-- ============================== inputs & controls ============================== -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#2A2F38"/>
    <SolidColorBrush x:Key="InputForegroundBrush" Color="#E4E7EC"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#4A515D"/>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#2A2F38"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#3C434F"/>
    <SolidColorBrush x:Key="ControlHoverBackgroundBrush" Color="#343B46"/>
    <SolidColorBrush x:Key="ControlPressedBackgroundBrush" Color="#404955"/>
    <SolidColorBrush x:Key="ControlDisabledForegroundBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="GlyphBrush" Color="#A7AEBA"/>

    <SolidColorBrush x:Key="ItemHoverBackgroundBrush" Color="#2E3540"/>
    <SolidColorBrush x:Key="ItemSelectedBackgroundBrush" Color="#33405A"/>

    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#262B33"/>
    <SolidColorBrush x:Key="PopupBorderBrush" Color="#414954"/>

    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#454C58"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#5C6472"/>

    <!-- ============================== "paper": how Word will render it ============================== -->
    <!-- deliberately still white — the previews stand for the printed page -->
    <SolidColorBrush x:Key="PaperBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PaperForegroundBrush" Color="#333333"/>
    <SolidColorBrush x:Key="PaperMutedForegroundBrush" Color="#888888"/>
    <SolidColorBrush x:Key="PaperBorderBrush" Color="#33000000"/>

    <!-- ============================== blocks ============================== -->
    <SolidColorBrush x:Key="BlockDataBrush" Color="#3E9B45"/>
    <SolidColorBrush x:Key="BlockDataBorderBrush" Color="#2C7433"/>
    <SolidColorBrush x:Key="BlockControlBrush" Color="#D18A14"/>
    <SolidColorBrush x:Key="BlockControlBorderBrush" Color="#A96D0F"/>
    <SolidColorBrush x:Key="BlockVariablesBrush" Color="#D67115"/>
    <SolidColorBrush x:Key="BlockVariablesBorderBrush" Color="#AC5A0F"/>
    <SolidColorBrush x:Key="BlockDocumentBrush" Color="#3A79D6"/>
    <SolidColorBrush x:Key="BlockDocumentBorderBrush" Color="#2A5CA8"/>
    <SolidColorBrush x:Key="BlockFolderBrush" Color="#7B52D6"/>
    <SolidColorBrush x:Key="BlockFolderBorderBrush" Color="#5F3FA8"/>

    <SolidColorBrush x:Key="HatBlockBrush" Color="#3A424E"/>
    <SolidColorBrush x:Key="BlockLabelForegroundBrush" Color="#F2F4F7"/>
    <SolidColorBrush x:Key="BlockSelectionBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BlockNestBackgroundBrush" Color="#26000000"/>
    <SolidColorBrush x:Key="BlockNestBorderBrush" Color="#4DFFFFFF"/>

    <DropShadowEffect x:Key="BlockSelectionGlow" Color="#5C9BFF"
                      BlurRadius="12" ShadowDepth="0" Opacity="1"/>

</ResourceDictionary>
